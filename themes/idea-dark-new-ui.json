  "semanticTokenColors": {
    "function.declaration": "#56A8F5",
    "method.declaration": "#56A8F5",
    "function": "#BCBEC4",
    "method": "#BCBEC4",
    "function.static": { "foreground": "#BCBEC4", "fontStyle": "italic" },
    "method.static": { "foreground": "#BCBEC4", "fontStyle": "italic" },
    "property": "#C77DBB",
    "property.static": { "foreground": "#C77DBB", "fontStyle": "italic" },
    "property.readonly": { "foreground": "#C77DBB", "fontStyle": "italic" },
    "variable": "#BCBEC4",
    "variable.readonly": { "foreground": "#C77DBB", "fontStyle": "italic" },
    "variable.static": { "foreground": "#C77DBB", "fontStyle": "italic" },
    "parameter": "#BCBEC4",
    "enumMember": { "foreground": "#C77DBB", "fontStyle": "italic" },
    "class": "#BCBEC4",
    "interface": "#BCBEC4",
    "type": "#BCBEC4",
    "typeParameter": "#16BAAC",
    "decorator": "#B3AE60",
    "namespace": "#BCBEC4",
    "*.deprecated": { "foreground": "#7A7E85", "fontStyle": "strikethrough" }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7A7E85", "fontStyle": "italic" }
    },
    {
      "name": "Doc Comments",
      "scope": ["comment.block.documentation", "comment.block.javadoc"],
      "settings": { "foreground": "#5F826B", "fontStyle": "italic" }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": { "foreground": "#CF8E6D" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#6AAB73" }
    },
    {
      "name": "Template Expressions & Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#CF8E6D" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#2AACB8" }
    },
    {
      "name": "Function & Method Declarations",
      "scope": [
        "entity.name.function",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": { "foreground": "#56A8F5" }
    },
    {
      "name": "Function Calls",
      "scope": ["meta.function-call entity.name.function", "support.function"],
      "settings": { "foreground": "#BCBEC4" }
    },
    {
      "name": "Annotations & Decorators",
      "scope": ["storage.type.annotation", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#B3AE60" }
    },
    {
      "name": "Properties & Fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#C77DBB" }
    },
    {
      "name": "Static Constants",
      "scope": ["variable.other.constant", "constant.other"],
      "settings": { "foreground": "#C77DBB", "fontStyle": "italic" }
    },
    {
      "name": "Classes, Types & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#BCBEC4" }
    },
    {
      "name": "Generic Type Parameters",
      "scope": ["entity.name.type.parameter", "meta.type.parameters entity.name.type"],
      "settings": { "foreground": "#16BAAC" }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#D5B778" }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#BABABA" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#C77DBB" }
    },
    {
      "name": "YAML Keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#CF8E6D" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#CF8E6D", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw"],
      "settings": { "foreground": "#6AAB73" }
    },
    {
      "name": "Operators & Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#BCBEC4" }
    }
  ]
}
